# Optional: endpoint that receives contact form submissions as JSON
# (e.g. a Formspree / Web3Forms / Power Automate HTTP URL).
# When empty, the form opens the visitor's email client instead.
PUBLIC_FORM_ENDPOINT=

# Optional: Google Analytics 4 measurement ID (starts with G-).
# When empty, no analytics script loads and no cookie banner is shown.
PUBLIC_GA_ID=
