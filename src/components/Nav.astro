---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { href, itemHref, langs, langNames, type Lang } from '@/i18n';
import type { Copy } from '@/i18n/en';
interface Props { lang: Lang; t: Copy; path: string }
const { lang, t, path } = Astro.props;
const home = href('/', lang);
const items = t.services.items;
const link = (i: (typeof items)[number]) => ({ label: i.name, to: itemHref(i, lang) });
const of = (kind: string) => items.filter((i) => i.kind === kind);
const courses = of('training').filter((i) => i.slug !== 'training');

type Col = { title?: string; links: { label: string; to: string }[] };
const menu: { label: string; to: string; cols?: Col[] }[] = [
  { label: t.nav.home, to: home },
  { label: t.nav.services, to: home + '#services', cols: [
    { title: t.nav.consulting, links: of('service').map(link) },
    { title: t.nav.solutions, links: of('product').map(link) },
  ] },
  { label: t.nav.technologies, to: home + '#technologies', cols: [{ links: of('technology').map(link) }] },
  { label: t.nav.training, to: href('/training', lang), cols: [{ links: [...courses.map(link), { label: t.nav.allTraining, to: href('/training', lang) }] }] },
  { label: t.nav.contact, to: href('/contact', lang) },
];
---
<header class="nav">
  <div class="wrap">
    <div class="nav-inner">
      <a href={home} aria-label="Infinity Analytics"><Logo /></a>
      <nav class="nav-desktop items-center gap-1" aria-label="Main">
        {menu.map((m) => m.cols ? (
          <div class="nav-item">
            <a class="nav-link" href={m.to} aria-haspopup="true">{m.label}
              <svg class="chev" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="m2 3.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="nav-drop">
              <div class:list={['nav-panel', m.cols.length > 1 && 'two']}>
                {m.cols.map((c) => (
                  <div>
                    {c.title && <p class="nav-col-title">{c.title}</p>}
                    <ul>{c.links.map((l) => <li><a class="nav-sub" href={l.to}>{l.label}<Arrow /></a></li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : <a class="nav-link" href={m.to}>{m.label}</a>)}
      </nav>
      <div class="flex items-center gap-2">
        {langs.length > 1 && (
          <div class="hidden sm:flex items-center font-mono text-xs rounded-full border border-line p-1">
            {langs.map((l) => (
              <a href={href(path, l)} hreflang={l} aria-current={l === lang ? 'true' : undefined}
                class:list={['px-2.5 py-1.5 rounded-full transition-colors', l === lang ? 'bg-fg/12 text-text' : 'text-muted hover:text-text']}>{langNames[l]}</a>
            ))}
          </div>
        )}
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
          <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"/></svg>
          <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
        </button>
        <a class="btn btn-primary btn-sm" href={href('/contact', lang)}>{t.nav.cta}<Arrow /></a>
        <button class="btn btn-ghost btn-sm" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">{t.nav.menu}</button>
      </div>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-lenis-prevent>
  {menu.map((m) => (
    <div class="mm-group">
      <a class="big" href={m.to}>{m.label}</a>
      {m.cols && (
        <div class="mm-subs">
          {m.cols.flatMap((c) => c.links).map((l) => <a href={l.to}>{l.label}</a>)}
        </div>
      )}
    </div>
  ))}
  <div class="mt-8 flex items-center gap-3">
    <a class="btn btn-primary" href={href('/contact', lang)}>{t.nav.cta}<Arrow /></a>
    {langs.filter((l) => l !== lang).map((l) => <a class="btn btn-ghost" href={href(path, l)} hreflang={l}>{langNames[l]}</a>)}
  </div>
</div>
