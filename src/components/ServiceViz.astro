      <path d="M196 62 L232 48 L268 36 L298 22 L298 62 L268 60 L232 62 Z" fill="rgba(254,184,93,.14)" />
      <path class="dash" d="M196 62 L232 52 L268 44 L298 34" fill="none" stroke={A} stroke-width="2.2" stroke-linecap="round" />
      <circle class="pulse" cx="196" cy="62" r="5" fill="#fff" />
      <line x1="196" x2="196" y1="18" y2="132" stroke={L} />
    </svg>
  )}
  {slug === 'microsoft-azure' && (
    <svg viewBox="0 0 320 150" preserveAspectRatio="xMidYMid meet">
      <path d="M118 62a22 22 0 0 1 42-9 17 17 0 0 1 30 8 15 15 0 0 1 2 30h-70a15 15 0 0 1-4-29Z" fill="rgba(139,92,255,.18)" stroke={V} stroke-width="1.4" />
      <circle class="pulse" cx="160" cy="68" r="6" fill={A} />
      {[[60, 'APP'], [160, 'API'], [260, 'SQL']].map(([x, l], i) => (
        <g>
          <path class="dash" d={`M160 92 C160 108,${x} 100,${x} 114`} fill="none" stroke={V} stroke-width="1.4" />
          <rect x={Number(x) - 34} y="114" width="68" height="26" rx="8" fill="rgba(255,255,255,.03)" stroke={L} />
          <circle class="pulse" style={`animation-delay:${i * 0.4}s`} cx={Number(x) - 20} cy="127" r="3.5" fill={i === 1 ? A : V} />
          <text x={Number(x) - 8} y="131" fill={T} font-size="10" font-family="monospace">{l}</text>
        </g>
      ))}
    </svg>
  )}
  {slug === 'ai-agents' && (
    <div class="absolute inset-0 p-4 flex flex-col justify-center gap-2.5 text-[0.72rem] font-mono">
      <div class="self-end max-w-[78%] rounded-2xl rounded-br-sm px-3 py-2 bg-brand text-white">Why did margin drop in Q3?</div>
      <div class="self-start max-w-[86%] rounded-2xl rounded-bl-sm px-3 py-2 border border-line bg-fg/5 text-soft">Freight costs rose 12% in EMEA. <span class="text-amber">See breakdown →</span></div>
      <div class="self-start rounded-2xl px-3 py-2.5 border border-line bg-fg/5 typing"><span></span><span></span><span></span></div>
    </div>
  )}
</div>
<style is:global>
  @keyframes growx { from { transform: scaleX(0.3); } to { transform: scaleX(1); } }
</style>
