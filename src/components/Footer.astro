---
import Logo from './Logo.astro';
import { byInterest, href, itemHref, type Lang } from '@/i18n';
import type { Copy } from '@/i18n/en';
import { site } from '@/site';
interface Props { lang: Lang; t: Copy }
const { lang, t } = Astro.props;
const of = (kind: string) => byInterest(t.services.items.filter((s) => s.kind === kind));
const cols = [
  { title: t.footer.services, items: of('service') },
  { title: t.footer.products, items: of('product') },
  { title: t.footer.technologies, items: of('technology') },
  { title: t.footer.training, items: of('training').filter((s) => s.slug !== 'training') },
];
---
<footer class="border-t border-line mt-10">
  <div class="wrap py-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.1fr_1fr_1.1fr_1.4fr]">
    <div>
      <Logo />
      <p class="mt-5 text-sm text-muted max-w-xs leading-relaxed">{t.footer.blurb}</p>
      <p class="mt-5 chip">{t.credentials.partner}</p>
    </div>
    {cols.map((c) => (
      <div>
        <h2 class="eyebrow mb-5">{c.title}</h2>
        <ul class="space-y-2.5 text-sm text-muted">
          {c.items.map((s) => <li><a class="hover:text-text transition-colors" href={itemHref(s, lang)}>{s.name}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <h2 class="eyebrow mb-5">{t.nav.contact}</h2>
      <ul class="space-y-2.5 text-sm text-muted">
        <li><a class="hover:text-text transition-colors break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="hover:text-text transition-colors" href={site.phoneHref}>{site.phone}</a></li>
        <li class="leading-relaxed pt-1">{site.address.map((l) => <span class="block">{l}</span>)}</li>
      </ul>
    </div>
  </div>
  <div class="wrap pb-10 flex flex-wrap items-center justify-between gap-4 text-xs text-muted font-mono">
    <span>© {new Date().getFullYear()} {site.name}. {t.footer.rights}</span>
    <span class="flex items-center gap-6">
      <a class="hover:text-text transition-colors" href={href('/privacy', lang)}>{t.privacy.link}</a>
      <a class="hover:text-text transition-colors" href="#top">{t.footer.top} ↑</a>
    </span>
  </div>
</footer>
