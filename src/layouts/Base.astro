---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { getCopy, href, base, htmlLang, langs, defaultLang, type Lang } from '@/i18n';
import { site } from '@/site';
interface Props { lang: Lang; path: string; title?: string; description?: string; noindex?: boolean }
const { lang, path, title, description, noindex } = Astro.props;
const t = getCopy(lang);
const pageTitle = title ?? t.meta.title;
const desc = description ?? t.meta.description;
const abs = (p: string) => new URL(p, Astro.site ?? site.url).href;
// Preview hosts (e.g. github.io) stay out of search results; only the real domain is indexed.
const isPreview = (Astro.site?.hostname ?? 'infinity-analytics.com') !== 'infinity-analytics.com';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  description: t.meta.description,
  address: { '@type': 'PostalAddress', streetAddress: site.address.slice(0, 2).join(', '), postalCode: '20000', addressLocality: 'Casablanca', addressCountry: 'MA' },
  areaServed: ['North America', 'Europe', 'Middle East and North Africa', 'Africa'],
};
---
<!doctype html>
<html lang={htmlLang[lang]} id="top" data-theme="light" data-ga={site.gaId || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {(isPreview || noindex) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(href(path, lang))} />
    {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(href(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(href(path, defaultLang))} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#f6f4ff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(href(path, lang))} />
    <meta property="og:image" content={abs(`${base}/og.png`)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      // Runs before paint: enable JS-only styles and restore the saved theme (light by default).
      (function () {
        var d = document.documentElement, t = 'light';
        d.classList.add('js');
        try { t = localStorage.getItem('theme') || t; } catch (e) {}
        d.dataset.theme = t === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-3 focus:left-3 focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded-full">{t.nav.skip}</a>
    <Nav lang={lang} t={t} path={path} />
    <main id="main"><slot /></main>
    <Footer lang={lang} t={t} />
    {site.gaId && (
      <div class="consent card" data-consent hidden role="region" aria-label="Cookies">
        <p class="text-sm text-muted leading-relaxed">{t.consent.text} <a class="underline hover:text-text" href={href('/privacy', lang)}>{t.privacy.link}</a></p>
        <div class="mt-4 flex gap-2">
          <button class="btn btn-primary btn-sm" type="button" data-consent-choice="granted">{t.consent.accept}</button>
          <button class="btn btn-ghost btn-sm" type="button" data-consent-choice="denied">{t.consent.decline}</button>
        </div>
      </div>
    )}
    <script>import '@/scripts/motion';</script>
  </body>
</html>
