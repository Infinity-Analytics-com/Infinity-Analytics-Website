---
import Base from '@/layouts/Base.astro';
import Arrow from '@/components/Arrow.astro';
import CTA from '@/components/CTA.astro';
import ServiceViz from '@/components/ServiceViz.astro';
import Showcase from '@/components/Showcase.astro';
import { mocks, showcaseFor } from '@/mocks';
import { getCopy, href, langPaths, resolveLang } from '@/i18n';
import { clients, testimonials } from '@/site';
export const getStaticPaths = langPaths;
const lang = resolveLang(Astro.params.lang);
const t = getCopy(lang);
const services = t.services.items.filter((s) => s.kind === 'service');
const products = t.services.items.filter((s) => s.kind === 'product');
const span = ['md:col-span-2', 'md:col-span-4', 'md:col-span-3', 'md:col-span-3', 'md:col-span-4', 'md:col-span-2'];
const half = Math.ceil(testimonials.length / 2);
const rows = [testimonials.slice(0, half), testimonials.slice(half)];
---
<Base lang={lang} path="/">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid"></div>
    <canvas id="infinity" aria-hidden="true"></canvas>
    <div class="hero-fade"></div>
    <div class="float-chip hidden lg:block right-[8%] top-[22%]" style="animation-delay:-2s">
      <div class="font-mono text-[0.65rem] uppercase tracking-widest text-muted">{t.hero.chips[0].k}</div>
      <div class="text-2xl font-medium tracking-tight">{t.hero.chips[0].v}</div>
    </div>
    <div class="float-chip hidden lg:block right-[30%] bottom-[20%]" style="animation-delay:-4.5s">
      <div class="font-mono text-[0.65rem] uppercase tracking-widest text-muted">{t.hero.chips[1].k}</div>
      <div class="text-2xl font-medium tracking-tight">{t.hero.chips[1].v} <span class="text-amber text-sm align-middle">● {t.hero.chips[2].v} {t.hero.chips[2].k.toLowerCase()}</span></div>
    </div>
    <div class="wrap relative z-[2]">
      <div class="max-w-3xl">
        <p class="eyebrow" data-reveal>{t.hero.eyebrow}</p>
        <h1 class="display split mt-7">{t.hero.titleA} <span class="em">{t.hero.titleEm}</span></h1>
        <p class="lead mt-8 max-w-xl" data-reveal>{t.hero.sub}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <a class="btn btn-primary" data-magnetic href={href('/contact', lang)}>{t.hero.primary}<Arrow /></a>
          <a class="btn btn-ghost" href="#services">{t.hero.secondary}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section id="clients" class="pb-6 scroll-mt-24">
    <p class="text-center font-mono text-[0.72rem] uppercase tracking-[0.14em] text-muted mb-8 px-4" data-reveal>{t.marquee.label}</p>
    <div class="marquee" data-reveal>
      {[0, 1].map((i) => <div class="marquee-track" aria-hidden={i === 1 ? 'true' : undefined}>{clients.map((c) => <span class="client">{c}</span>)}</div>)}
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section scroll-mt-10">
    <div class="wrap">
      <div class="max-w-3xl">
        <p class="eyebrow" data-reveal>{t.services.eyebrow}</p>
        <h2 class="h2 split mt-5">{t.services.title} <span class="em">{t.services.titleEm}</span></h2>
        <p class="lead mt-6 max-w-xl" data-reveal>{t.services.sub}</p>
      </div>
      <div class="mt-14 grid gap-4 md:grid-cols-6">
        {services.map((s, i) => (
          <a class:list={['card p-6 md:p-7 flex flex-col group', span[i]]} href={href(`/services/${s.slug}`, lang)} data-reveal>
            <ServiceViz slug={s.slug} />
            <div class="mt-6 flex items-center justify-between gap-3">
              <h3 class="h3">{s.name}</h3>
              <span class="chip">{s.tag}</span>
            </div>
            <p class="mt-3 text-muted leading-relaxed text-[0.97rem]">{s.short}</p>
            <span class="mt-auto pt-6 inline-flex items-center gap-2 text-sm text-soft group-hover:text-text transition-colors">{t.services.more}<span class="transition-transform group-hover:translate-x-1"><Arrow /></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SHOWCASE -->
  <Showcase t={t} page="home" />

  <!-- STATS -->
  <section class="pb-4">
    <div class="wrap">
      <div class="band" data-reveal>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/80 relative z-[1]">{t.stats.eyebrow}</p>
        <div class="mt-10 grid gap-10 sm:grid-cols-3 relative z-[1]">
          {t.stats.items.map((s) => (
            <div>
              <div class="stat-num" data-count={s.v} data-suffix={s.suffix}>{s.v}{s.suffix}</div>
              <div class="mt-3 text-white/85 text-lg">{s.k}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section id="approach" class="section scroll-mt-10">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 self-start">
        <p class="eyebrow" data-reveal>{t.process.eyebrow}</p>
        <h2 class="h2 split mt-5">{t.process.title} <span class="em">{t.process.titleEm}</span></h2>
        <p class="lead mt-6 max-w-md" data-reveal>{t.process.sub}</p>
        <a class="btn btn-ghost mt-9" href={href('/contact', lang)} data-reveal>{t.cta.primary}<Arrow /></a>
      </div>
      <div class="steps">
        <div class="steps-rail" aria-hidden="true"><div class="steps-fill"></div></div>
        <ol>
        {t.process.steps.map((s, i) => (
          <li class="step">
            <span class="step-dot">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3 pt-1">{s.t}</h3>
            <p class="mt-2 text-muted leading-relaxed max-w-md">{s.d}</p>
          </li>
        ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section !pt-0">
    <div class="wrap">
      <div class="max-w-3xl">
        <p class="eyebrow" data-reveal>{t.values.eyebrow}</p>
        <h2 class="h2 split mt-5">{t.values.title} <span class="em">{t.values.titleEm}</span></h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.values.items.map((v, i) => (
          <div class="card p-6" data-reveal>
            <span class="font-mono text-xs text-amber">0{i + 1}</span>
            <h3 class="h3 mt-8">{v.t}</h3>
            <p class="mt-3 text-muted leading-relaxed text-[0.95rem]">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="section !pt-0 scroll-mt-28">
    <div class="wrap">
      <div class="max-w-3xl">
        <p class="eyebrow" data-reveal>{t.products.eyebrow}</p>
        <h2 class="h2 split mt-5">{t.products.title} <span class="em">{t.products.titleEm}</span></h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((s) => (
          <a class="card p-5 md:p-6 flex flex-col group" href={href(`/services/${s.slug}`, lang)} data-reveal>
            <div class="viz mockviz" set:html={mocks[showcaseFor[s.slug][0]].svg} />
            <h3 class="h3 mt-6">{s.name}</h3>
            <p class="mt-3 text-muted leading-relaxed text-[0.95rem]">{s.short}</p>
            <span class="mt-auto pt-6 inline-flex items-center gap-2 text-sm text-soft group-hover:text-text transition-colors">{t.services.more}<span class="transition-transform group-hover:translate-x-1"><Arrow /></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- REACH -->
  <section class="section !pt-0">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="eyebrow" data-reveal>{t.reach.eyebrow}</p>
          <h2 class="h2 split mt-5">{t.reach.title} <span class="em">{t.reach.titleEm}</span></h2>
        </div>
        <p class="lead max-w-md lg:justify-self-end" data-reveal>{t.reach.sub}</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.reach.regions.map((r) => (
          <div class="card p-6" data-reveal>
            <div class="flex items-baseline justify-between gap-3 font-mono text-xs text-muted">
              <span>{r.city}</span>
              <span class="text-amber tabular-nums" data-tz={r.tz} title={t.reach.localTime}></span>
            </div>
            <h3 class="h3 mt-10">{r.name}</h3>
            <p class="mt-3 text-muted leading-relaxed text-[0.95rem]">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section !pt-0">
    <div class="wrap max-w-3xl !mx-auto text-center">
      <p class="eyebrow" data-reveal>{t.testimonials.eyebrow}</p>
      <h2 class="h2 split mt-5">{t.testimonials.title} <span class="em">{t.testimonials.titleEm}</span></h2>
    </div>
    <div class="mt-14 space-y-4">
      {rows.map((row, ri) => (
        <div class:list={['marquee', ri === 1 && 'reverse']} style="--gap:1rem;--dur:70s" data-reveal>
          {[0, 1].map((i) => (
            <div class="marquee-track !items-stretch" aria-hidden={i === 1 ? 'true' : undefined}>
              {[...row, ...row].map((q) => (
                <figure class="card quote flex flex-col">
                  <blockquote class="text-[1.02rem] leading-relaxed text-text/90">“{q.quote}”</blockquote>
                  <figcaption class="mt-auto pt-6 flex items-center gap-3">
                    <span class="grid place-items-center w-10 h-10 rounded-full bg-brand/70 border border-violet/60 text-white font-medium text-sm">{q.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
                    <span class="text-sm"><span class="block font-medium">{q.name}</span><span class="block text-muted">{q.org} · {q.country}</span></span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <CTA lang={lang} t={t} />
</Base>
